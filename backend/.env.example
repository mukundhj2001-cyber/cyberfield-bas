DATABASE_URL=sqlite:///./app/data/cyberfield.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gmail — mock by default. OAuth needs all three Google vars + GMAIL_MODE=oauth.
# Generate refresh token: python ../scripts/gmail_oauth_refresh_token.py --client-id ... --client-secret ...
GMAIL_MODE=mock
# GMAIL_MODE=oauth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# N8N_WEBHOOK_SECRET=change-me-local-demo

# Business inbox filter — drop newsletters / social / marketing on ingest
BUSINESS_FILTER_ENABLED=true
# BUSINESS_EMAIL_DOMAINS=acme.com,partner.example
# BUSINESS_FILTER_USE_LLM=false
