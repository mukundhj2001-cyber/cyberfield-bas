# Optional — leave unset to use deterministic mock agent (offline demo)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# LLM_PROVIDER=anthropic

# Backend
DATABASE_URL=sqlite:///./app/data/cyberfield.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gmail ingest — default mock (no secrets). For real Gmail set mode=oauth + credentials.
GMAIL_MODE=mock
# GMAIL_MODE=oauth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# n8n webhooks — when set, POST /webhooks/n8n/* requires header X-Webhook-Secret
# N8N_WEBHOOK_SECRET=change-me-local-demo

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
