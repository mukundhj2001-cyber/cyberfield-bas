# Optional — leave unset to use deterministic mock agent (offline demo)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
LLM_PROVIDER=mock
# LLM_PROVIDER=openai
# LLM_PROVIDER=anthropic

# Backend
DATABASE_URL=sqlite:///./app/data/cyberfield.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gmail ingest — default mock (no secrets). For real Gmail:
#   1) Enable Gmail API + create OAuth Desktop client in Google Cloud
#   2) python scripts/gmail_oauth_refresh_token.py --client-id ... --client-secret ...
#   3) Paste values below, set GMAIL_MODE=oauth, restart API
# Never commit real secrets.
GMAIL_MODE=mock
# GMAIL_MODE=oauth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# n8n webhooks — when set, POST /webhooks/n8n/* requires header X-Webhook-Secret
# N8N_WEBHOOK_SECRET=change-me-local-demo

# Frontend (Vite)
VITE_API_URL=http://localhost:8000

# Business inbox filter (heuristics; works offline with mock)
# BUSINESS_FILTER_ENABLED=true
# Comma-separated sender domains always treated as business
# BUSINESS_EMAIL_DOMAINS=acme.com,partner.example
# Optional LLM refinement for borderline mail (requires real LLM provider)
# BUSINESS_FILTER_USE_LLM=false

# On inbox sync, auto-stage full action plans into Approvals (human gate)
# AUTO_STAGE_ON_SYNC=true
